# ==============================================================
# .gitignore — OCI Oracle Linux 9 Secure Admin Stack
# ==============================================================
#
# These files must never be committed to version control.
# They contain real values substituted from the template files.
#
# Template files (safe to commit):
#   cloud-config.template.yaml  ← commit this
#   .env.example               ← commit this
#
# Generated files (never commit):
#   cloud-config.yaml          ← contains substituted domain, email, OCIDs
#   .env                       ← contains real OCI Vault OCIDs

# Generated deployment files
cloud-config.yaml
.env

# OS
.DS_Store
.directory

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

tmp/
