# Template for /data/containers/wg-easy/env.
# The deployment replaces INIT_PASSWORD and INIT_HOST on first boot.
PORT=51821
INSECURE=true
INIT_ENABLED=true
INIT_USERNAME=admin
INIT_PASSWORD=<<INJECT_AT_DEPLOYMENT>>
INIT_HOST=<<INSTANCE_PUBLIC_IP>>
INIT_PORT=51820
INIT_DNS=1.1.1.1
INIT_IPV4_CIDR=10.0.0.0/24
INIT_IPV6_CIDR=fd00::/64
INIT_ALLOWED_IPS=0.0.0.0/0,::/0
