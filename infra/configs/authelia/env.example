# Template for /data/authelia/env.
# The deployment replaces the two secrets with values from OCI Vault.
# PUID and PGID are filled from the authelia service account.
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=<<INJECT_AT_DEPLOYMENT>>
AUTHELIA_SESSION_SECRET=<<INJECT_AT_DEPLOYMENT>>
PUID=<<AUTHELIA_UID>>
PGID=<<AUTHELIA_GID>>
UMASK=0077
