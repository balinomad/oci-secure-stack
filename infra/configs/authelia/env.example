# Template for /etc/secure-stack/secret-refs/authelia.env.
# The deployment replaces each placeholder with an OCI Vault secret OCID,
# not the secret value.
# PUID, PGID, and UMASK are non-secret settings. They are written to the
# generated Quadlet drop-in.
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=<<INJECT_AT_DEPLOYMENT>>
AUTHELIA_SESSION_SECRET=<<INJECT_AT_DEPLOYMENT>>
AUTHELIA_STORAGE_ENCRYPTION_KEY=<<INJECT_AT_DEPLOYMENT>>
