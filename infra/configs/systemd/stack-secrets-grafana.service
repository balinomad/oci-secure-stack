[Unit]
Description=Materialize Grafana runtime secrets from OCI Vault
After=network-online.target local-fs.target
Wants=network-online.target
Requires=local-fs.target
Before=grafana-server.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/stack-secret-env --spec /etc/secure-stack/secret-refs/grafana.env --output /run/monitoring/grafana/env --owner grafana:grafana --mode 0600
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
