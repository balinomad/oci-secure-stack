[Unit]
Description=Materialize alerting runtime secrets from OCI Vault
After=network-online.target local-fs.target
Wants=network-online.target
Requires=local-fs.target
Before=pcp-alert-pmie.service pcp-service-check.service pcp-cert-check.service pcp-heartbeat.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/stack-secret-env --spec /etc/secure-stack/secret-refs/alerting.env --output /run/monitoring/alerting/env --owner alerting:alerting --mode 0600
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
