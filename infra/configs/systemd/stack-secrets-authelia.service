[Unit]
Description=Materialize Authelia runtime secrets from OCI Vault
After=network-online.target local-fs.target
Wants=network-online.target
Requires=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/install -d -m 0750 -o root -g authelia /run/authelia
ExecStart=/usr/local/libexec/stack-secret-env --spec /etc/secure-stack/secret-refs/authelia.env --output /run/authelia/env --owner authelia:authelia --mode 0600
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
