[Unit]
Description=Materialize Traefik runtime secrets from OCI Vault
After=network-online.target local-fs.target
Wants=network-online.target
Requires=local-fs.target
Before=traefik.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/stack-secret-env --spec /etc/secure-stack/secret-refs/traefik.env --output /run/traefik/env --owner traefik:traefik --mode 0600
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
