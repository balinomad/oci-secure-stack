# ==============================================================
# .env.example — Deployment Variable Template
# OCI Oracle Linux 9 Secure Admin Stack
# ==============================================================
#
# INSTRUCTIONS:
#
#   1. Copy this file to .env:
#        cp .env.example .env
#
#   2. Fill in all eight values below.
#
#   3. Generate the deployment file:
#        export $(cat .env | xargs)
#        scripts/repo/render-config.sh \
#          | envsubst '${DOMAIN} ${ACME_EMAIL} ${ADMIN_EMAIL} ${CF_SECRET_OCID} ${AUTH_SECRET_OCID} ${WG_SECRET_OCID} ${GRAFANA_SECRET_OCID} ${MONITORING_PROFILE}' \
#          > cloud-config.yaml
#
#   4. Paste cloud-config.yaml into the OCI Console User Data field,
#      or pass it via the OCI CLI:
#        oci compute instance launch --user-data-file cloud-config.yaml ...
#
# SECURITY:
#   - Never commit .env to version control.
#   - Never commit the generated cloud-config.yaml to version control.
#   - Add both to .gitignore:
#        echo ".env" >> .gitignore
#        echo "cloud-config.yaml" >> .gitignore
#
# See docs/guides/getting-started.md for full details.
#
# ==============================================================

# Base domain for all subdomains.
# All admin services are derived from this: auth.DOMAIN, traefik.DOMAIN, etc.
# Example: example.com
DOMAIN=

# Email address for Let's Encrypt certificate expiry notices.
# Example: ops@example.com
ACME_EMAIL=

# Email address for the Authelia admin user account.
# Can be the same as ACME_EMAIL in single-admin setups.
# Example: admin@example.com
ADMIN_EMAIL=

# OCID of the OCI Vault secret containing the Cloudflare DNS API token.
# Secret name in Vault: traefik-cloudflare-token
# See docs/guides/getting-started.md section 4.2 for how to create this secret.
# Example: ocid1.vaultsecret.oc1.ap-sydney-1.xxxx
CF_SECRET_OCID=

# OCID of the OCI Vault secret containing the Authelia admin password.
# Secret name in Vault: authelia-admin-password
# See docs/guides/getting-started.md section 4.3 for how to create this secret.
# Example: ocid1.vaultsecret.oc1.ap-sydney-1.yyyy
AUTH_SECRET_OCID=

# OCID of the OCI Vault secret containing the wg-easy admin password.
# Secret name in Vault: wg-easy-admin-password
# See docs/guides/getting-started.md section 4.4 for how to create this secret.
# Example: ocid1.vaultsecret.oc1.ap-sydney-1.zzzz
WG_SECRET_OCID=

# Local monitoring profile.
# live: Grafana with live PCP Vector metrics. Minimum 4 GB RAM, 2 vCPU, 2 GB free disk.
# history: live profile plus Valkey history. Minimum 6 GB RAM, 2 vCPU, 5 GB free disk.
# none: PCP only. No Grafana, no Valkey.
# See docs/reference/infrastructure.md section 8.
MONITORING_PROFILE=live

# OCID of the OCI Vault secret containing the Grafana admin password.
# Required when MONITORING_PROFILE is live or history.
# Secret name in Vault: grafana-admin-password
# See docs/guides/getting-started.md section 4.5 for how to create this secret.
# Example: ocid1.vaultsecret.oc1.ap-sydney-1.gggg
GRAFANA_SECRET_OCID=
