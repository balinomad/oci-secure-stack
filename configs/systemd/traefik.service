[Unit]
Description=Traefik Edge Router
After=network-online.target local-fs.target
Wants=network-online.target
Requires=local-fs.target

[Service]
Type=simple
User=traefik
Group=traefik

# Security: Minimal capabilities for binding ports 80/443
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service

# /var/log/traefik is a symlink to /data/logs/traefik (block volume)
ReadWritePaths=/data/traefik/letsencrypt /data/logs/traefik
EnvironmentFile=/etc/traefik/env
ExecStart=/usr/local/bin/traefik --configFile=/etc/traefik/traefik.yaml
Restart=always

[Install]
WantedBy=multi-user.target
