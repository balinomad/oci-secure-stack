[Unit]
Description=Check the earliest Traefik certificate expiry
After=network-online.target
Wants=network-online.target
OnFailure=pcp-alert-notify@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/stack-alerting check-cert
TimeoutStartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/data
ReadWritePaths=/var/lib/stack-alerting
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
LockPersonality=yes
UMask=0077
